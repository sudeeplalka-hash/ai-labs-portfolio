{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --force --store-dir \"$(mktemp -d /tmp/portfolio-pnpm-store.XXXXXX)\"",
  "buildCommand": "pnpm turbo run build --filter=@labs/web --force",
  "outputDirectory": "apps/web/out",
  "redirects": [
    {
      "source": "/industries/uc/el01-contact%20center-assist",
      "destination": "/industries/uc/el01-contact-center-assist/",
      "permanent": true
    }
  ],
  "git": { "deploymentEnabled": { "main": true } }
}
